---
import Layout from "../../layouts/Layout.astro";
import "../../styles/page.css";

export const prerender = false;

const { ticker } = Astro.params;
---

<Layout>

    <section class="extraInfo mainElement">

        <div class="mainStockInfo">

            <div id="stockTitleInfo">
                <h1 id="stockTitle"></h1>
                <h1 id="stockTicker"></h1>
                <hr>
            </div>

            <div id="dataRows">

                <div class="dataRow">
                    <h2>Bought At: </h2>
                    <h2 id="boughtAt"></h2>
                </div>

                <div class="dataRow">
                    <h2>Profit/Loss: </h2>
                    <h2 id="profitLoss"></h2>
                </div>

                <div class="dataRow">
                    <h2>Today Profit/Loss: </h2>
                    <h2 id="todayProfitLoss"></h2>
                </div>

                <div class="dataRow">
                    <h2>Change Today: </h2>
                    <h2 id="changeToday"></h2>
                </div>

                <div class="dataRow">
                    <h2>Volatility: </h2>
                    <h2 id="volatility"></h2>
                </div>

                <div class="dataRow">
                    <h2>52 Week High: </h2>
                    <h2 id="fiftyTwoWeekHigh"></h2>
                </div>

                <div class="dataRow">
                    <h2>Today Open: </h2>
                    <h2 id="todayOpen"></h2>
                </div>

                <div class="dataRow">
                    <h2>Today Close: </h2>
                    <h2 id="todayClose"></h2>
                </div>

                <div class="dataRow">
                    <h2>Today Low: </h2>
                    <h2 id="todayLow"></h2>
                </div>

                <div class="dataRow">
                    <h2>Today High: </h2>
                    <h2 id="todayHigh"></h2>
                </div>

                <div class="dataRow">
                    <h2>Stock Currency: </h2>
                    <h2 id="stockCurrency"></h2>
                </div>

            </div>
        </div>

        <div id="mainCandle" class="mainStockGraph box"></div>

    </section>


    <section id="descMonte" class="mainElement">

        <div id="monteCarloPageChart" class="mainStockGraph box" data-ticker={ticker}></div>

        <div id="stockDesc" class="mainStockInfo">

            <h1 id="stockTitle">Description</h1>
            <hr>
            <br>

            <p id="stockDescription" data-ticker={ticker}></p>

        </div>

    </section>


    <script>
        import { getOnlyToday } from "../../api.ts";
        import { resizeGraphs } from "../../page.ts";
        import { fetchDescription } from "../../web_scraper";

        const stockDescription = document.getElementById("stockDescription");
        const stockDesc = document.getElementById("stockDesc");

        const ticker = stockDescription?.dataset.ticker;
        const todayData = await getOnlyToday( ticker + "?holdingTime=true&interval=1d" );

        const today = todayData[0];

        const position = today.position.position;
        const yahooPosition = today.position.yahooPosition;

        const tels = yahooPosition.timestamp_elements;
        const lastTimestamp = tels[tels.length - 1];

        document.getElementById("stockTitle").textContent = position.name;
        document.getElementById("stockTicker").textContent = yahooPosition.ticker;
        document.getElementById("boughtAt").textContent = position.createdAt.split("T")[0];
        document.getElementById("profitLoss").textContent = `£${position.upl}`;
        document.getElementById("todayProfitLoss").textContent = `£${today.todaypl}`;
        document.getElementById("changeToday").textContent = `${today.tpcp}%`;
        document.getElementById("volatility").textContent = yahooPosition.volatility.toFixed(2);
        document.getElementById("fiftyTwoWeekHigh").textContent = yahooPosition.fiftyTwoWeekHigh;
        document.getElementById("todayOpen").textContent = lastTimestamp.open.toFixed(2);
        document.getElementById("todayClose").textContent = lastTimestamp.close.toFixed(2);
        document.getElementById("todayLow").textContent = lastTimestamp.low.toFixed(2);
        document.getElementById("todayHigh").textContent = lastTimestamp.high.toFixed(2);
        document.getElementById("stockCurrency").textContent = position.stockCurrency;

        const name = position.name;

        let description =
            await fetchDescription(ticker, name);

        if (description) {
            stockDescription.innerHTML = description;
        } else {
            stockDesc.style.display = "none";
            resizeGraphs();
        }
    </script>

</Layout>
