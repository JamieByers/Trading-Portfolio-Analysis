---
import Layout from "../../layouts/Layout.astro";
import "../../styles/dashboard.css"
import Table from "../../components/Table.astro"

const session = Astro.cookies.get("session_id");

if (!session) {
    return Astro.redirect("/login");
}

---

<Layout>

    <main>
        <section id="graphAndPositions" class="horizontal-parent">
            <div class="long-box">
                <div id="profitOverTime"></div>
            </div>

            <div class="top-right-box">
                <h1 id="positionCount" data-private>...</h1>
                <h2>Positions</h2>
            </div>
        </section>

        <section id="portfolioData" class="horizontal-parent">

            <div class="small-box">
                <div id="portfolioValue" class="singleDataBox">
                    <div>
                        <h1>Portfolio Value</h1>
                        <hr>
                    </div>

                    <div>
                        <h2 id="portfolioValueAmount" data-private>...</h2>
                        <h3 id="portfolioValueProfit" data-private>...</h3>
                    </div>
                </div>
            </div>

            <div class="small-box">
                <div id="portfolioProfit" class="singleDataBox">
                    <div>
                        <h1>Total P/L</h1>
                        <hr>
                    </div>

                    <div>
                        <h2 id="portfolioProfitAmount" data-private>...</h2>
                        <h3 id="portfolioProfitPercentage" data-private>...</h3>
                    </div>
                </div>
            </div>

            <div class="small-box">
                <div id="todaypl" class="singleDataBox">
                    <div>
                        <h1>Today P/L</h1>
                        <hr>
                    </div>

                    <div>
                        <h2 id="todayPLAmount" data-private>...</h2>
                        <h3 id="todayPLPercentage" data-private>...</h3>
                    </div>
                </div>
            </div>

        </section>

        <Table />
    </main>

</Layout>



<script>
    import { getData } from "../../api.ts"
    import { calculateTodayProfit } from "../../charts/analysis.ts"
    import { profitOverTime } from "../../charts/lineChart.ts"
    import * as echarts from "echarts"

    const allPositions = await getData("/profit-over-time")

    let portfolioValue = 0
    let portfolioProfit = 0
    let originalPortfolioValue = 0

    for (const cp of allPositions) {
        portfolioValue += cp.position.currentValue
        portfolioProfit += cp.position.upl
        originalPortfolioValue += cp.position.totalCost
    }

    portfolioValue = Math.round(portfolioValue * 100) / 100
    portfolioProfit = Math.round(portfolioProfit * 100) / 100

    const indicator = portfolioProfit > 0 ? "+" : ""

    let portfolioProfitPercentage =
        (portfolioValue - originalPortfolioValue)
        / originalPortfolioValue * 100

    portfolioProfitPercentage =
        Math.round(portfolioProfitPercentage * 100) / 100

    const todayplRaw = calculateTodayProfit(allPositions)

    const previousPortfolioValue = portfolioValue - todayplRaw

    let todayPercentage =
        (todayplRaw / previousPortfolioValue) * 100

    todayPercentage = Math.round(todayPercentage * 100) / 100

    const todayPercentageIndicator =
        todayPercentage > 0 ? "+" : ""

    let todayIndicator = "+"

    let todaypl = todayplRaw

    if (todaypl < 0) {
        todayIndicator = "-"
        todaypl *= -1
    }

    todaypl = Math.round(todaypl * 100) / 100


    // Update HTML

    document.querySelector("#positionCount").textContent =
        allPositions.length

    document.querySelector("#portfolioValueAmount").textContent =
        `£${portfolioValue}`

    document.querySelector("#portfolioValueProfit").textContent =
        `${indicator}£${portfolioProfit}`

    document.querySelector("#portfolioProfitAmount").textContent =
        `${indicator}£${portfolioProfit}`

    document.querySelector("#portfolioProfitPercentage").textContent =
        `${indicator}${portfolioProfitPercentage}%`

    document.querySelector("#todayPLAmount").textContent =
        `${todayIndicator}£${todaypl}`

    document.querySelector("#todayPLPercentage").textContent =
        `${todayPercentageIndicator}${todayPercentage}%`


    // Graph

    const profitOverTimeGraph = echarts.init(
        document.getElementById("profitOverTime")
    )

    const profitOverTimeOption = await profitOverTime()

    profitOverTimeOption.dataZoom = null

    profitOverTimeGraph.setOption(profitOverTimeOption)

    window.addEventListener("resize", () => {
        profitOverTimeGraph.resize()
    })
</script>
