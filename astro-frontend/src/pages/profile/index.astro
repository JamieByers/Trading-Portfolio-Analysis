---
    import Settings from "../../components/Settings.astro"

    const session = Astro.cookies.get("session_id");

    if (!session) {
        return Astro.redirect("/login");
    }


---

<Settings>

    <h1 id="accountSettings">Account Settings</h1>

    <form action="" id="accountSettingsForm">
        <!-- <div class="settingsRow"> -->
        <!--     <h2>Name </h2> -->
        <!--     <input type="text" name="name" id="name" class="settingsInput"> -->
        <!--     <div class="note">This name will only be used for personality and one does not need to be provided.</div> -->
        <!-- </div> -->

        <div class="settingsRow">
            <h2>Email </h2>
            <div>
                <input type="text" name="email" id="email" class="settingsInput">
                <!-- TODO : Add email verification for future email updates -->
                <!-- <button id="verifyEmailButton">Verify Email</button> -->
            </div>
            <div class="note">This will be the email used to recover your account and log in.</div>
        </div>

        <div class="settingsRow">
            <h2>Password </h2>
            <input type="password" name="password" id="password" class="settingsInput">
            <div class="note"></div>
        </div>
        <div class="settingsRow">
            <h2>Confirm Password </h2>
            <input type="password" name="confirm_password" id="confirm_password" class="settingsInput">
            <div class="note"></div>
        </div>

        <button type="submit">Update Profile</button>
    </form>


    <h1 id="accountPreferences">Account Preferences</h1>

    <form class="checkboxRows" action="">
        <div class="checkboxRow">
            <div class="checkboxToggle">
                <input type="checkbox" id="privacyModeCheckbox"><h2>Turn on privacy mode</h2>
            </div>
            <div class="note">This will hide any absolute data about your personal portfolio like portfolio value, total P/L and today P/L, it will however still show graph analysis. </div>
        </div>

        <div class="checkboxRow">
            <div class="checkboxToggle">
                <input type="checkbox" id="darkModeCheckbox"><h2>Turn on dark mode</h2>
            </div>
            <div class="note">This will change the theme of the website to dark mode</div>
        </div>

        <!-- <div class="checkboxRow"> -->
        <!--     <div class="checkboxToggle"> -->
        <!--         <input type="checkbox" id="larpModeCheckbox"><h2>Turn on larp mode</h2> -->
        <!--     </div> -->
        <!--     <div class="note">This will lie about any of your data from your personal portfolio like portfolio value, total P/L and today P/L. </div> -->
        <!-- </div> -->
    </form>

    <h1 id="tradingKeys">Trading Keys</h1>

    <form action="" id="keyRowsForm">
        <div class="keyInputs">
            <div class="settingsRow">
                <h2>Public Key </h2>
                <input type="text" name="publicKey" id="publicKey" class="settingsInput">
            </div>

            <div class="settingsRow">
                <h2>Private Key </h2>
                <input type="password" name="privateKey" id="privateKey" class="settingsInput">
            </div>
        </div>


        <div class="note">These keys will be fully encrypted and unable to access, making them secure and safe. These are used to get your personal data from your Trading 212 portfolio. Add at your own risk. </div>

        <button>Update Keys</button>
    </form>

    <h1 id="deleteAccount">Delete Account</h1>

    <form action="" id="deleteAccountForm">
        <h2>Once you delete your account you can easily create a new one, but no settings will remain.</h2>
        <button id="deleteButton">Delete Profile</button>
    </form>

    <!-- <!-1- Rounded switch -1-> -->
    <!-- <label class="switch"> -->
    <!--   <input type="checkbox"> -->
    <!--   <span class="slider round"></span> -->
    <!-- </label> -->

    <script>
        import { initDarkModeSettings } from "../../darkMode";

        await initDarkModeSettings()

    </script>

</Settings>
