---
import Layout from "../layouts/Layout.astro";
import Table from "../components/Table.astro"

const session = Astro.cookies.get("session_id");

if (!session) {
    return Astro.redirect("/login");
}

---

<Layout title="Homepage">

    <section id="mainPage">

      <section id="chartSection">
        <div class="loading">
          <h1>Loading...</h1>
          <h2>If you have not already added Trading Keys to your profile no data will be loaded. Please add Trading Keys to access your portfolio</h2>
        </div>

        <div id="chart" class="bigChart"></div>
      </section>

      <section id="infoBar">
        <div id="primaryInputBar" class="inputBar">
          <input
            type="text"
            id="primaryTickerInput"
            class="inputElement"
            placeholder="Stock Ticker 1: SNDK"
          />

          <input
            type="text"
            id="primaryRangeInput"
            class="inputElement"
            placeholder="Range: 1mo"
          />

          <input
            type="text"
            id="primaryIntervalInput"
            class="inputElement"
            placeholder="Interval: 1d"
          />
        </div>
      </section>

      <section class="extraInfo">
        <section id="pieChartSection">
          <div id="pieChart" class="box"></div>
        </section>

        <section>
          <div id="topChart" class="box"></div>
        </section>

        <section>
          <div id="portfolioOverTime" class="box"></div>
        </section>
      </section>

      <section class="extraInfo">
        <section id="todayBarGraphWinner">
          <div id="topWinnersToday" class="box"></div>
        </section>

        <section id="todayBarGraphLoser">
          <div id="topLosersToday" class="box"></div>
        </section>

        <section id="todayBarGraphMover">
          <div id="topMoversToday" class="box"></div>
        </section>
      </section>

      <section class="extraInfo">
        <div id="compareLeft" class="box"></div>
        <div id="compareRight" class="box"></div>
      </section>

      <section id="infoBar">

        <div id="cbar1" class="inputBar">
          <input
            type="text"
            id="compareInput1"
            class="inputElement"
            placeholder="Stock Ticker 1: SNDK"
          />

          <input
            type="text"
            id="rangeInput1"
            class="inputElement"
            placeholder="Range: 1mo"
          />

          <input
            type="text"
            id="intervalInput1"
            class="inputElement"
            placeholder="Interval: 1d"
          />
        </div>

        <div id="cbar2" class="inputBar">
          <input
            type="text"
            id="compareInput2"
            class="inputElement"
            placeholder="Stock Ticker 2: ASML"
          />

          <input
            type="text"
            id="rangeInput2"
            class="inputElement"
            placeholder="Range: 1mo"
          />

          <input
            type="text"
            id="intervalInput2"
            class="inputElement"
            placeholder="Interval: 1d"
          />
        </div>

      </section>

      <section id="chartSection">
        <div id="profitOverTime" class="bigChart"></div>
      </section>

      <section id="chartSection">
        <div id="volatilityOverTime" class="bigChart"></div>
      </section>

      <section id="chartSection">
        <div id="riskReturnGraph" class="bigChart"></div>
      </section>

      <section id="chartSection">
        <div id="monteCarloGraph" class="bigChart"></div>
      </section>

      <section id="infoBar">
        <div id="monteCarloInputBar" class="inputBar">

          <input
            type="text"
            id="monteCarloTickerInput"
            class="inputElement"
            placeholder="Stock Ticker 1: SNDK"
          />

          <input
            type="text"
            id="monteCarloHistoryInput"
            class="inputElement"
            placeholder="Available Dataset (days only): 100"
          />

          <input
            type="text"
            id="monteCarloPeriodInput"
            class="inputElement"
            placeholder="Period Forward (days only): 100"
          />

          <input
            type="text"
            id="monteCarloNSimulationsInput"
            class="inputElement"
            placeholder="Number of Simulations: 100"
          />

        </div>
      </section>

        <Table></Table>


    </section>



    <script>
      import {initHomepage} from "../main";

      await initHomepage();
    </script>


</Layout>
