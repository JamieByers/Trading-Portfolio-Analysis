---
import "../styles/style.css";
import "../styles/navbar.css";

const { title = "Trading Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
</head>

<body>

    <nav>

        <section id="mobileNavbar">

            <div class="topMobileNav">
                <a href="/">
                    <h1 style="font-size: 24px;">JTrading</h1>
                </a>

                <button class="nav-toggle" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <div class="links">
                <a href="/">
                    <h1 class="mobileNavbarLink">Home</h1>
                </a>

                <a href="/search">
                    <h1 class="mobileNavbarLink">Search</h1>
                </a>

                <a href="/dashboard">
                    <h1 class="mobileNavbarLink">Dashboard</h1>
                </a>

                <a href="">
                    <h1 class="mobileNavbarLink">Profile</h1>
                </a>
            </div>

        </section>

        <section class="navbar">

            <div class="navItem navLeft">

                <a href="/">
                    <h1 style="font-size: 24px;">JTrading</h1>
                </a>

                <a href="/">
                    <h1>Home</h1>
                </a>

                <a href="/search">
                    <h1>Search</h1>
                </a>

                <a href="/dashboard">
                    <h1>Dashboard</h1>
                </a>

            </div>

            <div class="navItem navRight">
                <a href="">
                    <h1>Profile</h1>
                </a>
            </div>

        </section>

    </nav>

    <main>
        <slot />
    </main>

    <script>
        import { initNavbar } from "../navbar";

        initNavbar();
    </script>

</body>
</html>
